node_modules/
bin/
.DS_Store
*.log
.env
.env.*
!.env.*.example
.gemini-key-state.json
# Bun --compile temp artifacts. Each build emits a new hash-named .bun-build
# file in cwd; glob catches all of them.
*.bun-build
.gstack/
supabase/.temp/
.claude/skills/
# admin/dist/ is the React SPA bundle. CLAUDE.md says it's committed for
# self-contained binaries (the bun --compile path embeds it via
# `import path from 'admin/dist/index.html' with { type: 'file' }`).
# Build via: cd admin && bun install && bun run build.
admin/node_modules/
.idea
eval/reports/
eval/data/world-v1/world.html

# BrainBench amara-life-v1 Opus cache (regenerate via eval:generate-amara-life)
eval/data/amara-life-v1/_cache/

# claw-test E2E build cache (shim + scratch outputs)
test/.cache/

.claude/
export/

# Conductor workspace-local agent artifacts: plans, todos, run-unit-parallel
# failure logs and per-shard test output. v0.26.4 (run-unit-parallel.sh)
# writes .context/test-failures.log + .context/test-summary.txt +
# .context/test-shards/. Workspace-local by design — never committed.
.context/

# Tier 3 PGLite snapshot fixture (built on demand by build:pglite-snapshot)
test/fixtures/pglite-snapshot.tar
test/fixtures/pglite-snapshot.version

# Private brain reports — never check these in
reports/network-intelligence/

# Prediction data (local runtime only)
predictions/signals/
predictions/resolutions/
predictions/dreams/
predictions/knowledge/

# Daily prediction reports (local files, not committed)
Report/
.github/workflows/

# Prediction pipeline runtime state (markets, seen signal ids). Rebuilt by
# scripts/run-prediction-cycle.ts; never meant to be committed.
.prediction-state.json
.prediction-state.json.tmp-*

# Run transcripts and generated reports from run-analytics-cycle.ps1.
logs/
Report/

# Cross-process run locks (scripts/lib/run-lock.ts)
.locks/
.prediction-state.*.bak
.gemini-key-state.*.bak

# Backtest snapshot cache (regenerate with scripts/backtest-fetch.ts)
.backtest-snapshots.json
.backtest-results*.json
# Run data is committed to the `backtest-data` orphan branch by
# scripts/backtest-commit.ts, deliberately never to main.
.backtest-progress.json
